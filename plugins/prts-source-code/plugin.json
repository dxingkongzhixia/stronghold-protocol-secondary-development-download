{
  "$schema": "../../schemas/plugin.schema.json",
  "manifest": 2,
  "name": {
    "zh": "PRTS：源代码",
    "en": "PRTS: Source Code"
  },
  "description": {
    "zh": "PRTS 主题的敌人插件：新增 PRTS / 拟态机械 Boss、隐藏协议与专属波次，并把这些 Boss 加入各模式的对手池。凯尔希策略已拆到「PRTS：凯尔希」插件。",
    "en": "A PRTS-themed enemy plugin: the PRTS / mimic bosses, the hidden protocol and their waves, added to every mode's boss pool. The Kal'tsit strategy now lives in the separate “PRTS: Kal'tsit” plugin."
  },
  "version": "0.1.0",
  "app": ">=0.4.0 <0.5.0",
  "api": 2,
  "class": "content",
  "category": "enemy",
  "scope": [
    "room"
  ],
  "permissions": [
    "data.add",
    "data.patch",
    "assets.add"
  ],
  "data": [
    "content/enemies.json",
    "content/bosses.json",
    "content/waves.json",
    "content/modes.json"
  ],
  "assets": {
    "enemies": {
      "enemy_x_prts_source_code_prts": {
        "icon": "assets/images/enemy_x_prts_source_code_prts.png",
        "spine": {
          "skel": "assets/spine/enemy/enemy_1564_mpprts/enemy_1564_mpprts.skel",
          "atlas": "assets/spine/enemy/enemy_1564_mpprts/enemy_1564_mpprts.atlas",
          "textures": [
            "assets/spine/enemy/enemy_1564_mpprts/enemy_1564_mpprts.png"
          ],
          "pma": true
        }
      },
      "enemy_x_prts_source_code_prts_hidden": {
        "icon": "assets/images/enemy_x_prts_source_code_prts.png",
        "spine": {
          "skel": "assets/spine/enemy/enemy_1564_mpprts/enemy_1564_mpprts.skel",
          "atlas": "assets/spine/enemy/enemy_1564_mpprts/enemy_1564_mpprts.atlas",
          "textures": [
            "assets/spine/enemy/enemy_1564_mpprts/enemy_1564_mpprts.png"
          ],
          "pma": true
        }
      },
      "enemy_x_prts_source_code_mimic": {
        "icon": "assets/images/enemy_x_prts_source_code_mimic.png",
        "spine": {
          "skel": "assets/spine/enemy/enemy_1565_mpprme/enemy_1565_mpprme.skel",
          "atlas": "assets/spine/enemy/enemy_1565_mpprme/enemy_1565_mpprme.atlas",
          "textures": [
            "assets/spine/enemy/enemy_1565_mpprme/enemy_1565_mpprme.png"
          ],
          "pma": true
        }
      }
    },
    "audio": {
      "bossBgm": {
        "boss_x_prts_source_code_prts": {
          "ref": "boss_8"
        },
        "boss_x_prts_source_code_prts_hidden": {
          "ref": "boss_8"
        }
      }
    },
    "fx": {
      "index": "assets/fx/index.json",
      "official": true
    }
  }
}
