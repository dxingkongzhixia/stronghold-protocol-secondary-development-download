{
  "$schema": "../../schemas/plugin.schema.json",
  "manifest": 2,
  "name": {
    "zh": "PRTS：源代码",
    "en": "PRTS: Source Code"
  },
  "description": {
    "zh": "PRTS 主题内容插件：新增 PRTS / 拟态机械 Boss、隐藏协议，以及凯尔希与 M3 的「凯尔希」策略。选择 PRTS 作为对手后可在策略选择中使用。",
    "en": "A PRTS-themed content plugin: the PRTS / mimic bosses, the hidden protocol, and Kal'tsit with M3 in the Emergency Reinforcement strategy. Pick PRTS as the opponent to use it."
  },
  "version": "0.1.0",
  "app": ">=0.4.0 <0.5.0",
  "api": 2,
  "class": "content",
  "scope": [
    "room"
  ],
  "permissions": [
    "data.add",
    "data.patch",
    "assets.add"
  ],
  "data": [
    "data/tokens.json",
    "content/enemies.json",
    "content/bosses.json",
    "content/waves.json",
    "content/bands.json",
    "content/modes.json"
  ],
  "operators": [
    "data/operator.json"
  ],
  "assets": {
    "bands": {
      "band_x_prts_source_code_touch": { "ref": "band_amedic" }
    },
    "enemies": {
      "enemy_x_prts_source_code_prts": {
        "icon": "assets/images/enemy_x_prts_source_code_prts.png",
        "spine": {
          "skel": "assets/spine/enemy/enemy_1564_mpprts/enemy_1564_mpprts.skel",
          "atlas": "assets/spine/enemy/enemy_1564_mpprts/enemy_1564_mpprts.atlas",
          "textures": [
            "assets/spine/enemy/enemy_1564_mpprts/enemy_1564_mpprts.png"
          ],
          "pma": true
        }
      },
      "enemy_x_prts_source_code_prts_hidden": {
        "icon": "assets/images/enemy_x_prts_source_code_prts.png",
        "spine": {
          "skel": "assets/spine/enemy/enemy_1564_mpprts/enemy_1564_mpprts.skel",
          "atlas": "assets/spine/enemy/enemy_1564_mpprts/enemy_1564_mpprts.atlas",
          "textures": [
            "assets/spine/enemy/enemy_1564_mpprts/enemy_1564_mpprts.png"
          ],
          "pma": true
        }
      },
      "enemy_x_prts_source_code_mimic": {
        "icon": "assets/images/enemy_x_prts_source_code_mimic.png",
        "spine": {
          "skel": "assets/spine/enemy/enemy_1565_mpprme/enemy_1565_mpprme.skel",
          "atlas": "assets/spine/enemy/enemy_1565_mpprme/enemy_1565_mpprme.atlas",
          "textures": [
            "assets/spine/enemy/enemy_1565_mpprme/enemy_1565_mpprme.png"
