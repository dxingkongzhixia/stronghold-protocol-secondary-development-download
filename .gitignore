# --- dependencies & generated client libs -------------------------------------------------------
node_modules/
# a local npm cache (npm_config_cache=./.npm-cache, npm ci --cache .npm-cache — GitHub #258)
.npm-cache/

# --- runtime static resources: committed so a clone runs without fetching art --------------------
# public/assets/**, public/fonts/** and public/vendor/** ARE tracked in the repository (GitHub primary + Gitee
# mirror; owner decision
# 2026-10-08): a plain `git clone` is runnable with no mirror/extraction step. They were previously
# git-ignored and delivered out-of-band by tools/fetch-assets.mjs (a public mirror) or
# tools/local-extract/. Refreshing upstream art per machine is now optional:
#   node tools/fetch-assets.mjs --asset-source=mirror
# public/vendor/** is still copied from node_modules by tools/vendor.mjs (postinstall).
# The repo is public and this art is (c) Hypergryph / Yostar — see docs/ASSETS.md / docs/AI-WORKFLOW.md.

# tools/local-extract/extract.py → public/assets/local/** and this per-machine manifest
# (optional: the client and the tests work without it; docs/DEPLOY.md §6 lists what falls back)
# Battlefield scenes (0.2.5): the extracted official scene files live under public/assets/local/scene/ and MUST NOT
# be committed — this fork tracks public/assets/** otherwise. Downloaded bundles live in .cache/official-scenes/
# (ignored by .cache/ below). The repository never stores those official files — see docs/ASSETS.md.
public/assets/local/scene/
data/local-assets.json
# download caches, upstream tables, ledgers, reports, setup state
.cache/

# --- Python (optional local-client extraction) ----------------------------------------------------
.venv*/
venv/
__pycache__/
*.py[cod]

# --- content packs (docs/PACKS.md): the pack index for a static host, generated by `node tools/packs.mjs index`
# (the server answers /packs/index.json itself; tools/package.mjs writes this file into the release zips) -----------
packs/index.json

# --- tests & logs ----------------------------------------------------------------------------------
test/e2e/out/
logs/
*.log

# --- per-machine config (scripts/install-service-windows.ps1) ------------------------------------
scripts/service.env.cmd
.env
.env.*

# --- OS / editor clutter ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/
.claude/

# accounts / matchmaking SQLite (server/db.mjs)
/var/
# tools/sim-check.mjs: the corpus and its Node traces for /dev/sim-check.html
public/dev/simcheck/data/
